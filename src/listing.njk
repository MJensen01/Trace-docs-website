---
layout: base.njk
useMap: true
pagination:
  data: homes.listings
  size: 1
  alias: l
permalink: "/listing/{{ l.id }}/"
eleventyComputed:
  title: "{{ l.title }}"
  description: "{{ l.title }} in {{ l.place }}."
---

<div class="mx-auto flex w-full max-w-6xl gap-6 px-4 pb-16 pt-5 sm:px-6 lg:gap-8">

  <!-- Listing browser: a sticky sidebar from lg up, a slide-in drawer below it. -->
  <div id="browse-backdrop" class="fixed inset-0 z-40 hidden bg-sand-950/50 lg:hidden"></div>

  <aside id="browse-panel" aria-label="All listings"
         class="invisible fixed bottom-0 left-0 top-0 z-50 flex w-[85%] max-w-xs -translate-x-full flex-col border-r border-sand-200 bg-sand-50 shadow-2xl transition-transform duration-200 ease-out lg:visible lg:sticky lg:bottom-auto lg:top-14 lg:z-30 lg:max-h-[calc(100vh-4.5rem)] lg:w-64 lg:max-w-none lg:translate-x-0 lg:shrink-0 lg:self-start lg:rounded-2xl lg:border lg:shadow-sm dark:border-sand-800 dark:bg-sand-900">

    <div class="flex items-center justify-between gap-2 border-b border-sand-200 px-3 py-1.5 dark:border-sand-800">
      <p class="text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">All {{ homes.counts.total }} listings</p>
      <button type="button" id="browse-close"
              class="tap -mr-1.5 w-11 rounded-xl text-sand-500 hover:text-clay-700 lg:hidden dark:text-sand-400 dark:hover:text-clay-300">
        <span class="sr-only">Close the listing browser</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"/>
        </svg>
      </button>
    </div>

    <div id="browse-scroll" class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-1.5">
      <ul class="space-y-0.5">
        {% for item in homes.browse %}
          {% set here = item.id == l.id %}
          <li>
            <a href="/listing/{{ item.id }}/"
               {% if here %}aria-current="page"{% endif %}
               class="browse-row band-{{ item.bandKey }} flex min-h-11 items-center gap-2.5 rounded-xl px-2.5 py-1.5 {% if here %}bg-clay-600 text-white{% else %}text-sand-700 hover:bg-sand-100 dark:text-sand-200 dark:hover:bg-sand-800{% endif %}{% if item.isGone %} opacity-55 saturate-50{% endif %}">
              <span class="band-bar h-7 w-1 shrink-0 rounded-full" aria-hidden="true"></span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-[0.8125rem] font-medium leading-snug">{{ item.title }}</span>
                <span class="block truncate text-[0.6875rem] tabular-nums {% if here %}text-clay-100{% else %}text-sand-500 dark:text-sand-400{% endif %}">
                  {{ item.rentLabel if item.rentLabel else "Rent TBD" }}{% if item.workMins %} &middot; {{ item.workMins }} min work{% endif %}
                </span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </aside>

  <div class="mx-auto w-full min-w-0 max-w-3xl">

  <div class="flex items-center justify-between gap-2">
    <a href="/" class="tap -ml-2 gap-1.5 rounded-xl px-2 text-sm font-medium text-sand-500 hover:text-clay-700 dark:text-sand-400 dark:hover:text-clay-300">
      <span aria-hidden="true">&larr;</span> All listings
    </a>
    <button type="button" id="browse-open" aria-expanded="false" aria-controls="browse-panel"
            class="tap gap-2 rounded-xl border border-sand-300 bg-white px-3 text-sm font-semibold text-sand-700 hover:border-clay-400 hover:text-clay-700 lg:hidden dark:border-sand-700 dark:bg-sand-900 dark:text-sand-200 dark:hover:text-clay-300">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      Browse listings
    </button>
  </div>

  <!-- Filled in from /api/hidden when this one has been archived. -->
  <div id="archived-banner" class="mt-3 hidden flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-2xl border border-amber-300/80 bg-amber-50 px-4 py-3 dark:border-amber-900/70 dark:bg-amber-950/40" role="status">
    <div class="min-w-0">
      <p class="text-sm text-amber-900 dark:text-amber-200">
        <span class="font-semibold" id="archived-text">Archived</span>
        &mdash; hidden from the dashboard and map.
      </p>
      <p id="archived-reason" class="mt-0.5 hidden text-xs text-amber-800/80 dark:text-amber-300/80"></p>
    </div>
    <button type="button" id="banner-unarchive"
            class="tap shrink-0 rounded-xl border border-amber-400 bg-white px-4 text-sm font-semibold text-amber-800 hover:border-amber-500 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">Unarchive</button>
  </div>

  <article class="band-{{ l.bandKey }} mt-2">

    <!-- Hero -->
    <div class="overflow-hidden rounded-2xl border border-sand-200 dark:border-sand-800">
      {% if l.img %}
        <!-- Screenshots vary in shape, so let the real one show rather than crop it. -->
        <img src="{{ l.img }}" alt="Screenshot of the {{ l.title }} listing"
             class="max-h-[34rem] w-full bg-sand-100 object-contain object-top dark:bg-sand-800">
      {% else %}
        <div class="photo-placeholder flex aspect-[16/9] w-full flex-col items-center justify-center gap-2 text-sand-500 dark:text-sand-400">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10 opacity-70" aria-hidden="true">
            <path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9.5 21v-6h5v6"/>
          </svg>
          <p class="text-xs font-medium">No screenshot saved yet</p>
        </div>
      {% endif %}
    </div>

    <!-- Title + rent -->
    <header class="mt-5">
      <h1 class="font-serif text-2xl font-semibold leading-tight tracking-tight text-sand-900 sm:text-3xl dark:text-sand-50">{{ l.title }}</h1>
      <p class="mt-1.5 text-sm text-sand-600 dark:text-sand-400">
        {% if l.subtitle %}{{ l.subtitle }}<br class="sm:hidden">{% endif %}
        {% if l.subtitle %}<span class="hidden sm:inline">&middot; </span>{% endif %}{{ l.place }}
      </p>

      <div class="mt-3 flex flex-wrap items-center gap-1.5">
        <span class="band-pill inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold">{{ l.band.label }}</span>
        <span class="inline-flex items-center rounded-full border border-sand-200 bg-sand-100 px-2.5 py-1 text-xs font-medium text-sand-600 dark:border-sand-700 dark:bg-sand-800 dark:text-sand-300">{{ l.tierLabel }}</span>
        <span class="inline-flex items-center rounded-full border border-sand-200 bg-sand-100 px-2.5 py-1 text-xs font-medium text-sand-600 dark:border-sand-700 dark:bg-sand-800 dark:text-sand-300">{{ l.kind | capitalize }}</span>
        {% if l.isGone %}
          <span class="inline-flex items-center rounded-full border border-rose-300 bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-700 dark:border-rose-900 dark:bg-rose-950 dark:text-rose-300">No longer listed</span>
        {% else %}
          <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-medium {% if l.verificationInfo.tone == 'good' %}border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-300{% else %}border-sand-200 bg-sand-100 text-sand-600 dark:border-sand-700 dark:bg-sand-800 dark:text-sand-300{% endif %}">{{ l.verificationInfo.label }}</span>
        {% endif %}
      </div>
    </header>

    <div class="mt-5 flex flex-wrap items-end justify-between gap-4 rounded-2xl border border-sand-200 bg-white p-4 dark:border-sand-800 dark:bg-sand-900">
      <div>
        <p class="font-serif text-4xl font-semibold leading-none tabular-nums text-sand-900 dark:text-sand-50">
          {{ l.rentLabel if l.rentLabel else "Rent TBD" }}
        </p>
        <p class="mt-1.5 text-sm text-sand-500 dark:text-sand-400">
          {% if l.overByLabel %}
            {% if l.bandKey == "stretch" %}
              <span class="font-semibold text-amber-600 dark:text-amber-400">{{ l.overByLabel }} over budget</span>
            {% else %}
              <span class="font-semibold text-rose-600 dark:text-rose-400">{{ l.overByLabel }} over budget</span>
            {% endif %}
            <span class="text-sand-400 dark:text-sand-500">&middot; cap is {{ homes.budgetMaxLabel }}</span>
          {% elif l.rentLabel %}
            per month &middot; under the {{ homes.budgetMaxLabel }} cap
          {% else %}
            No rent published &mdash; call to ask
          {% endif %}
        </p>
      </div>
      <p class="text-lg leading-none text-amber-500" aria-label="Our rating: {{ l.rating }} out of 5">
        <span aria-hidden="true">{% for on in l.stars %}{% if on %}&#9733;{% else %}<span class="text-sand-300 dark:text-sand-700">&#9733;</span>{% endif %}{% endfor %}</span>
      </p>
    </div>

    <!-- Actions -->
    <div class="mt-4 flex flex-wrap gap-2">
      {% if l.url %}
        <a href="{{ l.url }}" target="_blank" rel="noopener noreferrer"
           class="tap grow gap-2 rounded-xl bg-clay-600 px-5 text-sm font-semibold text-white hover:bg-clay-700 sm:grow-0">
          View original listing
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
            <path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
          </svg>
        </a>
      {% endif %}
      {% if l.hasRoute %}
        <a href="#map-section" class="tap grow gap-2 rounded-xl border border-sand-300 bg-white px-5 text-sm font-semibold text-sand-700 hover:border-clay-400 hover:text-clay-700 sm:grow-0 dark:border-sand-700 dark:bg-sand-900 dark:text-sand-200 dark:hover:text-clay-300">
          See on map
        </a>
      {% endif %}
    </div>
    {% if not l.url %}
      <p class="mt-2 text-xs text-sand-500 dark:text-sand-400">No direct link on file &mdash; this one came from a market survey rather than a single listing.</p>
    {% endif %}

    <!-- Commutes -->
    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      <div class="rounded-2xl border border-sand-200 bg-white p-4 dark:border-sand-800 dark:bg-sand-900">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
          <span class="h-2.5 w-2.5 rounded-full bg-route-work" aria-hidden="true"></span> Drive to work
        </p>
        <p class="mt-1.5 text-lg font-semibold tabular-nums {% if l.workSlow %}text-rose-600 dark:text-rose-400{% else %}text-sand-900 dark:text-sand-50{% endif %}">{{ l.workLabel if l.workLabel else "Unknown" }}</p>
        <p class="mt-0.5 text-xs text-sand-500 dark:text-sand-400">{{ homes.anchors.work.label }}</p>
      </div>
      <div class="rounded-2xl border border-sand-200 bg-white p-4 dark:border-sand-800 dark:bg-sand-900">
        <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400">
          <span class="h-2.5 w-2.5 rounded-full bg-route-home" aria-hidden="true"></span> Drive to family
        </p>
        <p class="mt-1.5 text-lg font-semibold tabular-nums text-sand-900 dark:text-sand-50">{{ l.homeLabel if l.homeLabel else "Unknown" }}</p>
        <p class="mt-0.5 text-xs text-sand-500 dark:text-sand-400">{{ homes.anchors.home.label }}</p>
      </div>
    </div>

    <!-- Facts -->
    <h2 class="mt-8 font-serif text-lg font-semibold text-sand-900 dark:text-sand-50">The details</h2>
    {% set facts = [
      { label: "Bedrooms", value: l.bedsLabel },
      { label: "Bathrooms", value: l.bathsLabel },
      { label: "Size", value: l.sqftLabel },
      { label: "Available", value: l.available },
      { label: "Lease", value: l.lease },
      { label: "Move-in cost", value: l.move_in_cost },
      { label: "Last checked", value: l.lastCheckedLabel }
    ] %}
    <dl class="mt-3 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-sand-200 bg-sand-200 sm:grid-cols-4 dark:border-sand-800 dark:bg-sand-800">
      {% for fact in facts %}
        <div class="bg-white px-4 py-3 dark:bg-sand-900">
          <dt class="text-xs font-medium text-sand-500 dark:text-sand-400">{{ fact.label }}</dt>
          <dd class="mt-0.5 text-sm font-medium text-sand-800 dark:text-sand-100">
            {% if fact.value and fact.value != "—" %}{{ fact.value }}{% else %}<span class="text-sand-400 dark:text-sand-500">Not listed</span>{% endif %}
          </dd>
        </div>
      {% endfor %}
      <div class="bg-white px-4 py-3 dark:bg-sand-900">
        <dt class="text-xs font-medium text-sand-500 dark:text-sand-400">Added</dt>
        <dd class="mt-0.5 text-sm font-medium text-sand-800 dark:text-sand-100">{{ l.addedLabel if l.addedLabel else "—" }}</dd>
      </div>
    </dl>

    <!-- Pros & cons -->
    {% if l.prosList.length or l.consList.length %}
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {% if l.prosList.length %}
          <section class="rounded-2xl border border-emerald-200/70 bg-emerald-50/50 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/25">
            <h2 class="font-serif text-base font-semibold text-emerald-800 dark:text-emerald-300">What we like</h2>
            <ul class="mt-2 space-y-1.5">
              {% for item in l.prosList %}
                <li class="flex gap-2 text-sm leading-relaxed text-sand-700 dark:text-sand-200">
                  <span class="mt-[0.45em] h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"></span>
                  <span>{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
        {% if l.consList.length %}
          <section class="rounded-2xl border border-amber-200/70 bg-amber-50/50 p-4 dark:border-amber-900/60 dark:bg-amber-950/25">
            <h2 class="font-serif text-base font-semibold text-amber-800 dark:text-amber-300">Watch out for</h2>
            <ul class="mt-2 space-y-1.5">
              {% for item in l.consList %}
                <li class="flex gap-2 text-sm leading-relaxed text-sand-700 dark:text-sand-200">
                  <span class="mt-[0.45em] h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500" aria-hidden="true"></span>
                  <span>{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      </div>
    {% endif %}

    {% if l.notes %}
      <section class="mt-6 rounded-2xl border border-sand-200 bg-white p-4 dark:border-sand-800 dark:bg-sand-900">
        <h2 class="font-serif text-base font-semibold text-sand-900 dark:text-sand-50">Notes</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-sand-600 dark:text-sand-300">{{ l.notes }}</p>
      </section>
    {% endif %}

    <!-- Map -->
    {% if l.hasRoute %}
      {% set mapPayload = { listing: { lat: l.lat, lon: l.lon, title: l.title, band: l.bandKey, rent: l.rentLabel }, route: l.route, anchors: homes.anchors } %}
      <section id="map-section" class="mt-8 scroll-mt-20">
        <h2 class="font-serif text-lg font-semibold text-sand-900 dark:text-sand-50">Where it is, and both drives</h2>

        <div class="mt-3 overflow-hidden rounded-2xl border border-sand-200 dark:border-sand-800">
          <div id="listing-map" class="map-shell h-[22rem] w-full sm:h-[26rem]" role="img" aria-label="Map of {{ l.title }} with driving routes to work and family"></div>
          <div class="map-shell border-t border-sand-200 px-4 py-3 dark:border-sand-800">
            <ul class="space-y-1.5 text-sm">
              <li class="flex items-center gap-2.5">
                <span class="h-1 w-6 shrink-0 rounded-full bg-route-work" aria-hidden="true"></span>
                <span><strong class="font-semibold">Work &mdash; {{ homes.anchors.work.short }}:</strong> {{ l.workLabel if l.workLabel else "unknown" }}</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span class="h-1 w-6 shrink-0 rounded-full bg-route-home" aria-hidden="true"></span>
                <span><strong class="font-semibold">Home &mdash; {{ homes.anchors.home.short }}:</strong> {{ l.homeLabel if l.homeLabel else "unknown" }}</span>
              </li>
            </ul>
          </div>
        </div>

        <p class="mt-2 text-xs text-sand-500 dark:text-sand-400">Drive times are free-flow estimates (no traffic).</p>
        <script id="map-data" type="application/json">{{ mapPayload | jsonScript | safe }}</script>
      </section>
    {% endif %}

    <!-- Prev / next -->
    <nav class="mt-10 grid gap-2 border-t border-sand-200 pt-5 sm:grid-cols-2 dark:border-sand-800" aria-label="Other listings">
      <a href="/listing/{{ l.prev.id }}/" class="group rounded-xl border border-sand-200 bg-white px-4 py-3 hover:border-clay-400 dark:border-sand-800 dark:bg-sand-900">
        <span class="text-xs font-medium text-sand-500 dark:text-sand-400">&larr; Previous</span>
        <span class="mt-0.5 block truncate text-sm font-semibold text-sand-800 group-hover:text-clay-700 dark:text-sand-100 dark:group-hover:text-clay-300">{{ l.prev.title }}</span>
      </a>
      <a href="/listing/{{ l.next.id }}/" class="group rounded-xl border border-sand-200 bg-white px-4 py-3 text-right hover:border-clay-400 dark:border-sand-800 dark:bg-sand-900">
        <span class="text-xs font-medium text-sand-500 dark:text-sand-400">Next &rarr;</span>
        <span class="mt-0.5 block truncate text-sm font-semibold text-sand-800 group-hover:text-clay-700 dark:text-sand-100 dark:group-hover:text-clay-300">{{ l.next.title }}</span>
      </a>
    </nav>

    <!-- Manage: quiet by design — the page is for reading. -->
    <section id="manage" class="mt-8 border-t border-sand-200 pt-5 dark:border-sand-800" data-listing="{{ l.id }}">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-sand-400 dark:text-sand-500">Manage</h2>

      <div id="manage-idle" class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
        <button type="button" id="manage-open"
                class="tap -ml-2 rounded-xl px-2 text-sm font-medium text-sand-500 hover:text-clay-700 dark:text-sand-400 dark:hover:text-clay-300">
          Archive this listing
        </button>
        <p id="manage-note" class="text-xs text-sand-400 dark:text-sand-500">
          Takes it off the dashboard and the map. Nothing is deleted &mdash; you can bring it back here.
        </p>
      </div>

      <form id="manage-form" class="mt-2 hidden max-w-md rounded-2xl border border-sand-200 bg-white p-4 dark:border-sand-800 dark:bg-sand-900" novalidate>
        <div id="manage-reason-wrap">
          <label for="manage-reason" class="block text-sm font-medium text-sand-700 dark:text-sand-200">
            Why? <span class="font-normal text-sand-400 dark:text-sand-500">(optional)</span>
          </label>
          <input type="text" id="manage-reason" autocomplete="off" placeholder="Gone, too far, we saw it&hellip;"
                 class="mt-1.5 h-11 w-full rounded-xl border border-sand-300 bg-white px-3.5 text-sm text-sand-800 placeholder:text-sand-400 focus:border-clay-400 dark:border-sand-700 dark:bg-sand-950 dark:text-sand-100 dark:placeholder:text-sand-500">
        </div>

        <div class="mt-3">
          <p class="block text-sm font-medium text-sand-700 dark:text-sand-200">Who&rsquo;s doing this?</p>
          <div class="mt-1.5 flex gap-2">
            {% for person in [{ value: "matt", label: "Matt" }, { value: "evelyn", label: "Evelyn" }] %}
              <button type="button" data-who="{{ person.value }}" aria-pressed="{{ 'true' if loop.first else 'false' }}"
                      class="chip border-sand-300 bg-white text-sand-700 hover:border-clay-400 hover:text-clay-700 aria-pressed:border-clay-600 aria-pressed:bg-clay-600 aria-pressed:text-white dark:border-sand-700 dark:bg-sand-950 dark:text-sand-300 dark:hover:text-clay-300 dark:aria-pressed:border-clay-500 dark:aria-pressed:bg-clay-600 dark:aria-pressed:text-white">{{ person.label }}</button>
            {% endfor %}
          </div>
        </div>

        <div class="mt-3 flex flex-wrap items-end gap-2">
          <div>
            <label for="manage-pin" class="block text-sm font-medium text-sand-700 dark:text-sand-200">PIN</label>
            <input type="password" id="manage-pin" inputmode="numeric" autocomplete="off" placeholder="••••"
                   class="mt-1.5 h-11 w-28 rounded-xl border border-sand-300 bg-white px-3.5 text-sm tracking-widest text-sand-800 placeholder:tracking-normal placeholder:text-sand-400 focus:border-clay-400 dark:border-sand-700 dark:bg-sand-950 dark:text-sand-100 dark:placeholder:text-sand-500">
          </div>
          <button type="submit" id="manage-confirm"
                  class="tap rounded-xl bg-clay-600 px-5 text-sm font-semibold text-white hover:bg-clay-700 disabled:opacity-60">Archive</button>
          <button type="button" id="manage-cancel"
                  class="tap rounded-xl px-3 text-sm font-medium text-sand-500 hover:text-sand-700 dark:text-sand-400 dark:hover:text-sand-200">Cancel</button>
        </div>

        <p id="manage-msg" class="mt-2 hidden text-sm" role="status" aria-live="polite"></p>
      </form>
    </section>

  </article>
  </div>
</div>

<script>
(function () {
  var panel = document.getElementById("browse-panel");
  var scroller = document.getElementById("browse-scroll");
  if (!panel || !scroller) return;

  var backdrop = document.getElementById("browse-backdrop");
  var openBtn = document.getElementById("browse-open");
  var closeBtn = document.getElementById("browse-close");
  var desktop = window.matchMedia("(min-width: 64rem)");

  // Centre the listing you are on inside the panel's own scroller, without
  // nudging the page itself.
  var current = scroller.querySelector('[aria-current="page"]');
  if (current) {
    scroller.scrollTop =
      current.getBoundingClientRect().top -
      scroller.getBoundingClientRect().top +
      scroller.scrollTop -
      (scroller.clientHeight - current.offsetHeight) / 2;
  }

  function setOpen(open) {
    panel.classList.toggle("-translate-x-full", !open);
    panel.classList.toggle("invisible", !open);
    if (backdrop) backdrop.classList.toggle("hidden", !open);
    document.body.classList.toggle("overflow-hidden", open);
    if (openBtn) openBtn.setAttribute("aria-expanded", open ? "true" : "false");
    if (open && closeBtn) closeBtn.focus();
    else if (!open && openBtn) openBtn.focus();
  }

  if (openBtn) openBtn.addEventListener("click", function () { setOpen(true); });
  if (closeBtn) closeBtn.addEventListener("click", function () { setOpen(false); });
  if (backdrop) backdrop.addEventListener("click", function () { setOpen(false); });

  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && !panel.classList.contains("invisible") && !desktop.matches) {
      setOpen(false);
    }
  });

  // Rotate to a wide screen mid-browse and the drawer state must not linger.
  function reset() {
    if (desktop.matches) {
      panel.classList.add("-translate-x-full", "invisible");
      if (backdrop) backdrop.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
      if (openBtn) openBtn.setAttribute("aria-expanded", "false");
    }
  }
  if (desktop.addEventListener) desktop.addEventListener("change", reset);
  else if (desktop.addListener) desktop.addListener(reset);
})();
</script>

<script>
// Archive / unarchive. One little form does both jobs; when /api is unreachable
// the section simply never reports anything and the page reads as normal.
document.addEventListener("DOMContentLoaded", function () {
  var section = document.getElementById("manage");
  if (!section || !window.HF) return;

  var listingId = section.getAttribute("data-listing");
  var banner = document.getElementById("archived-banner");
  var bannerText = document.getElementById("archived-text");
  var bannerReason = document.getElementById("archived-reason");
  var bannerBtn = document.getElementById("banner-unarchive");
  var idle = document.getElementById("manage-idle");
  var openBtn = document.getElementById("manage-open");
  var note = document.getElementById("manage-note");
  var form = document.getElementById("manage-form");
  var reasonWrap = document.getElementById("manage-reason-wrap");
  var reason = document.getElementById("manage-reason");
  var pin = document.getElementById("manage-pin");
  var confirmBtn = document.getElementById("manage-confirm");
  var cancelBtn = document.getElementById("manage-cancel");
  var msg = document.getElementById("manage-msg");
  var whoButtons = Array.prototype.slice.call(form.querySelectorAll("[data-who]"));

  var who = HF.getWho();
  var archived = null; // { who, ts, reason } once we know
  var busy = false;

  function paintWho() {
    whoButtons.forEach(function (button) {
      button.setAttribute("aria-pressed", button.getAttribute("data-who") === who ? "true" : "false");
    });
  }
  whoButtons.forEach(function (button) {
    button.addEventListener("click", function () {
      who = button.getAttribute("data-who");
      paintWho();
    });
  });
  paintWho();

  function paint() {
    var isArchived = Boolean(archived);
    banner.classList.toggle("hidden", !isArchived);
    banner.classList.toggle("flex", isArchived);
    if (isArchived) {
      bannerText.textContent =
        "Archived by " + HF.whoLabel(archived.who) +
        (HF.dateLabel(archived.ts) ? " on " + HF.dateLabel(archived.ts) : "");
      bannerReason.textContent = archived.reason || "";
      bannerReason.classList.toggle("hidden", !archived.reason);
    }
    openBtn.textContent = isArchived ? "Unarchive this listing" : "Archive this listing";
    note.textContent = isArchived
      ? "Puts it back on the dashboard and the map."
      : "Takes it off the dashboard and the map. Nothing is deleted — you can bring it back here.";
    confirmBtn.textContent = isArchived ? "Unarchive" : "Archive";
    reasonWrap.classList.toggle("hidden", isArchived);
  }

  function openForm() {
    // Inline style, not a `hidden` class: the row already carries a display
    // utility and Tailwind's own ordering would decide which of them wins.
    idle.style.display = "none";
    form.classList.remove("hidden");
    msg.classList.add("hidden");
    pin.value = HF.getPin();
    pin.focus({ preventScroll: true });
    form.scrollIntoView({ block: "center" });
  }

  function closeForm() {
    form.classList.add("hidden");
    idle.style.display = "";
    msg.classList.add("hidden");
  }

  function say(text, tone) {
    msg.textContent = text;
    msg.className =
      "mt-2 text-sm " +
      (tone === "bad" ? "font-medium text-rose-600 dark:text-rose-400" : "text-sand-500 dark:text-sand-400");
  }

  openBtn.addEventListener("click", openForm);
  bannerBtn.addEventListener("click", openForm);
  cancelBtn.addEventListener("click", closeForm);

  form.addEventListener("submit", function (event) {
    event.preventDefault();
    if (busy) return;
    if (!pin.value) {
      say("The PIN is missing.", "bad");
      HF.shake(pin);
      return;
    }

    busy = true;
    confirmBtn.disabled = true;
    say(archived ? "Unarchiving…" : "Archiving…");

    var path = archived ? "/api/unarchive" : "/api/archive";
    var payload = { listing_id: listingId, pin: pin.value, who: who };
    if (!archived) payload.reason = reason.value.trim() || null;

    HF.post(path, payload).then(function (res) {
      busy = false;
      confirmBtn.disabled = false;
      if (res.ok) {
        HF.setPin(pin.value);
        HF.setWho(who);
        archived = archived
          ? null
          : { who: who, ts: new Date().toISOString(), reason: payload.reason };
        paint();
        closeForm();
        return;
      }
      say(HF.message(res), "bad");
      if (res.status === 403) HF.shake(pin);
    });
  });

  HF.hidden().then(function (index) {
    archived = index[listingId] || null;
    paint();
  });
});
</script>

{% if l.hasRoute %}
<script>
document.addEventListener("DOMContentLoaded", function () {
  var host = document.getElementById("listing-map");
  var payload = document.getElementById("map-data");
  if (!host || !payload || typeof L === "undefined") return;

  var data;
  try { data = JSON.parse(payload.textContent); } catch (err) { return; }

  var BAND_COLORS = {
    "in-budget": "#059669",
    "stretch": "#d97706",
    "over": "#78716c",
    "unknown": "#64748b"
  };
  var WORK_COLOR = "#2563eb";
  var HOME_COLOR = "#7c3aed";

  L.Icon.Default.imagePath = "/assets/vendor/leaflet/images/";

  var map = L.map(host, { scrollWheelZoom: false });
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors'
  }).addTo(map);

  var bounds = [];

  function anchorIcon(color, glyph) {
    return L.divIcon({
      className: "",
      html: '<span class="anchor-pin" style="background:' + color + '">' + glyph + "</span>",
      iconSize: [32, 32],
      iconAnchor: [16, 16],
      popupAnchor: [0, -14]
    });
  }

  function drawRoute(leg, color) {
    if (leg && leg.geometry && leg.geometry.length > 1) {
      L.polyline(leg.geometry, {
        color: color,
        weight: 5,
        opacity: 0.85,
        lineCap: "round",
        lineJoin: "round"
      }).addTo(map);
      leg.geometry.forEach(function (point) { bounds.push(point); });
    }
  }

  drawRoute(data.route && data.route.work, WORK_COLOR);
  drawRoute(data.route && data.route.home, HOME_COLOR);

  if (data.anchors && data.anchors.work && data.anchors.work.lat !== null) {
    L.marker([data.anchors.work.lat, data.anchors.work.lon], {
      icon: anchorIcon(WORK_COLOR, "&#128188;"),
      title: data.anchors.work.label,
      alt: "Work: " + data.anchors.work.label
    }).addTo(map).bindPopup("<strong>Work</strong><br>" + data.anchors.work.label);
    bounds.push([data.anchors.work.lat, data.anchors.work.lon]);
  }

  if (data.anchors && data.anchors.home && data.anchors.home.lat !== null) {
    L.marker([data.anchors.home.lat, data.anchors.home.lon], {
      icon: anchorIcon(HOME_COLOR, "&#127968;"),
      title: data.anchors.home.label,
      alt: "Family: " + data.anchors.home.label
    }).addTo(map).bindPopup("<strong>Family</strong><br>" + data.anchors.home.label);
    bounds.push([data.anchors.home.lat, data.anchors.home.lon]);
  }

  if (data.listing && data.listing.lat !== null) {
    var here = [data.listing.lat, data.listing.lon];
    L.circleMarker(here, {
      radius: 10,
      color: "#ffffff",
      weight: 3,
      fillColor: BAND_COLORS[data.listing.band] || BAND_COLORS.unknown,
      fillOpacity: 1
    }).addTo(map).bindPopup(
      "<strong>" + data.listing.title + "</strong>" +
      (data.listing.rent ? "<br>" + data.listing.rent + " / mo" : "")
    );
    bounds.push(here);
  }

  if (bounds.length) {
    map.fitBounds(bounds, { padding: [28, 28] });
  } else {
    map.setView([40.3, -74.65], 10);
  }
});
</script>
{% endif %}
