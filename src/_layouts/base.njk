<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  <meta name="color-scheme" content="light dark">
  <title>{% if title %}{{ title }} · {% endif %}Matt &amp; Evelyn&rsquo;s Home Finder</title>
  <meta name="description" content="{{ description | default('A private list of rentals we are considering, with rent, commute times and maps.') }}">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8F%A1%3C/text%3E%3C/svg%3E">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Home Finder">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f4">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17140f">
  <link rel="stylesheet" href="/css/output.css">
  <!-- Client for the small write-API (worker/index.js). Deferred, so every page
       script that needs it can wait for DOMContentLoaded. -->
  <script src="/assets/js/hf.js" defer></script>
  {% if useMap %}
  <link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
  <script src="/assets/vendor/leaflet/leaflet.js" defer></script>
  {% endif %}
</head>
<body class="min-h-screen bg-sand-50 font-sans text-sand-800 antialiased dark:bg-sand-950 dark:text-sand-200">

  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-clay-700 focus:shadow-lg dark:focus:bg-sand-800 dark:focus:text-clay-300">Skip to content</a>

  <header class="sticky top-0 z-40 border-b border-sand-200/80 bg-sand-50/90 backdrop-blur-sm dark:border-sand-800 dark:bg-sand-950/90">
    <nav class="mx-auto flex max-w-6xl items-center gap-1 px-3 sm:px-5" aria-label="Main">
      <a href="/" class="tap -ml-2 gap-2 whitespace-nowrap rounded-xl px-2 font-serif text-base font-semibold tracking-tight text-sand-900 hover:text-clay-600 sm:text-lg dark:text-sand-50 dark:hover:text-clay-400">
        <span aria-hidden="true" class="text-lg">&#127969;</span>
        <span>Home Finder</span>
      </a>
      <a href="/list/" class="tap rounded-xl px-3 text-sm font-medium text-sand-600 hover:bg-sand-100 hover:text-clay-700 dark:text-sand-400 dark:hover:bg-sand-800 dark:hover:text-clay-300">List</a>
      <a href="/all/" class="tap rounded-xl px-3 text-sm font-medium text-sand-600 hover:bg-sand-100 hover:text-clay-700 dark:text-sand-400 dark:hover:bg-sand-800 dark:hover:text-clay-300">Database</a>
      <a href="/add/" class="tap rounded-xl px-3 text-sm font-medium text-sand-600 hover:bg-sand-100 hover:text-clay-700 dark:text-sand-400 dark:hover:bg-sand-800 dark:hover:text-clay-300">Add</a>
      <span class="ml-auto shrink-0 whitespace-nowrap text-xs text-sand-500 dark:text-sand-400">
        <!-- Four nav items plus the date is a squeeze on a phone: shorten the
             date on small screens, and drop it entirely on the narrowest ones. -->
        <span class="hidden sm:inline">Updated {{ homes.updatedLabel }}</span><span class="hidden min-[26rem]:inline sm:hidden">{{ homes.updatedShortLabel }}</span>
      </span>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="mx-auto max-w-6xl px-4 py-10 text-xs leading-relaxed text-sand-500 sm:px-6 dark:text-sand-400">
    <p>Private list for Matt &amp; Evelyn. Data updated {{ homes.updatedLabel }} &middot; {{ homes.counts.total }} listings tracked.</p>
    <p class="mt-1">Rents and availability change fast &mdash; always confirm with the leasing office before making plans.</p>
  </footer>

</body>
</html>
