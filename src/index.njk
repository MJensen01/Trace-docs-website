---
layout: base.njk
pagination:
  data: homes.searches
  size: 1
  alias: search
permalink: "{{ search.basePath }}"
useMap: true
eleventyComputed:
  # The primary search owns "/" and is the site's front door, so it carries no
  # page title of its own; every other search's map is titled.
  title: "{{ '' if search.isPrimary else 'Map' }}"
  # `| safe` keeps the computed value RAW — base.njk escapes it once into the
  # meta attribute, and without this an apostrophe comes out double-escaped.
  description: "{{ search.blurb | safe }}"
---

{# The map page for ONE search (this template is paginated over homes.searches,
   one page per search — "/" for the primary, "{basePath}" for the rest).
   Filters mirror the card list ({basePath}list/); tapping a marker opens the
   detail panel on the right. All behaviour lives in /assets/js/map-app.js;
   this page is just the shell plus a baked copy of this search's data feed as
   the offline fallback (the app prefers GET /api/data?search=<key>).

   Chips come from search.filters — generated in homes.js from the search's
   bands, kinds, states and bool facts — so a new fact or kind needs no edit
   here. #}

<div class="mx-auto max-w-[100rem] px-3 pt-4 sm:px-5">

  <section aria-label="Filter the map" class="mb-3">
    <div class="-mx-3 overflow-x-auto px-3 pb-1 no-scrollbar sm:mx-0 sm:overflow-visible sm:px-0">
      <div class="flex w-max items-center gap-2 sm:w-full sm:flex-wrap">
        {% for chip in search.filters %}
          <button type="button"
                  class="chip {% if chip.band %}band-{{ chip.band }}{% endif %} border-sand-300 bg-white text-sand-700 hover:border-clay-400 hover:text-clay-700 aria-pressed:border-clay-600 aria-pressed:bg-clay-600 aria-pressed:text-white dark:border-sand-700 dark:bg-sand-900 dark:text-sand-300 dark:hover:text-clay-300 dark:aria-pressed:border-clay-500 dark:aria-pressed:bg-clay-600 dark:aria-pressed:text-white"
                  data-group="{{ chip.group }}"
                  data-value="{{ chip.value }}"
                  aria-pressed="{{ 'true' if chip.group == 'all' else 'false' }}">
            {% if chip.band %}<span class="band-bar h-2 w-2 shrink-0 rounded-full" aria-hidden="true"></span>{% endif %}
            {% if chip.heart %}<span class="heart-glyph leading-none" aria-hidden="true">&#10084;</span>{% endif %}
            {{ chip.label }}
          </button>
        {% endfor %}
        <span id="map-count" class="ml-1 whitespace-nowrap text-xs text-sand-500 dark:text-sand-400" role="status" aria-live="polite">
          {{ search.counts.total }} listings
        </span>
        <a href="{{ search.basePath }}list/" class="ml-auto hidden whitespace-nowrap text-xs font-semibold text-clay-700 hover:text-clay-600 sm:inline dark:text-clay-300">
          Browse as cards &rarr;
        </a>
      </div>
    </div>
  </section>

  <div class="relative overflow-hidden rounded-2xl border border-sand-200 dark:border-sand-800">
    <div id="home-map" class="map-shell h-[calc(100dvh-11.5rem)] min-h-[26rem] w-full" role="application" aria-label="Map of every tracked listing"></div>

    <!-- Detail panel: slides in over the right edge of the map. -->
    <aside id="panel" aria-label="Listing details" aria-hidden="true"
           class="absolute inset-y-0 right-0 z-[1100] flex w-full translate-x-full flex-col border-l border-sand-200 bg-sand-50 shadow-2xl transition-transform duration-300 ease-out sm:w-[26rem] dark:border-sand-800 dark:bg-sand-950">
      <button type="button" id="panel-close"
              class="tap absolute right-2 top-2 z-10 w-11 rounded-xl bg-sand-950/60 text-white backdrop-blur-sm hover:bg-sand-950/80">
        <span class="sr-only">Close details</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"/>
        </svg>
      </button>
      <div id="panel-body" class="min-h-0 flex-1 overflow-y-auto overscroll-contain"></div>
    </aside>
  </div>

  <p class="mt-2 pb-2 text-xs text-sand-500 dark:text-sand-400">
    Tap a dot for details &middot; drive times are free-flow estimates (no traffic).
  </p>
</div>

<script id="map-config" type="application/json">{{ search.feed | jsonScript | safe }}</script>
<script src="/assets/js/map-app.js" defer></script>
