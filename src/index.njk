---
layout: base.njk
description: Every rental we are tracking, with rent, commute times and ratings.
---

<div class="mx-auto max-w-6xl px-4 pb-16 pt-6 sm:px-6 sm:pt-10">

  <section class="mb-7">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-clay-600 dark:text-clay-400">Our shortlist</p>
    <h1 class="mt-1.5 font-serif text-3xl font-semibold leading-tight tracking-tight text-sand-900 sm:text-4xl dark:text-sand-50">
      Matt &amp; Evelyn&rsquo;s Home Finder
    </h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-sand-600 dark:text-sand-400">
      {{ homes.counts.total }} places we&rsquo;re tracking near {{ homes.anchors.work.short }} and {{ homes.anchors.home.short }}.
      Budget is {{ homes.budgetMaxLabel }}, stretching to {{ homes.budgetStretchLabel }}.
      Last updated {{ homes.updatedLabel }}.
    </p>

    <dl class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
      {% set stats = [
        { label: "In budget", value: homes.counts.inBudget, band: "in-budget" },
        { label: "Stretch", value: homes.counts.stretch, band: "stretch" },
        { label: "Over budget", value: homes.counts.over, band: "over" },
        { label: "Rated 4★ or 5★", value: homes.counts.topRated, band: "unknown" }
      ] %}
      {% for stat in stats %}
        <div class="band-{{ stat.band }} rounded-2xl border border-sand-200 bg-white px-3.5 py-3 dark:border-sand-800 dark:bg-sand-900">
          <dt class="flex items-center gap-1.5 text-xs font-medium text-sand-500 dark:text-sand-400">
            <span class="band-bar h-2 w-2 shrink-0 rounded-full" aria-hidden="true"></span>
            {{ stat.label }}
          </dt>
          <dd class="mt-0.5 font-serif text-2xl font-semibold tabular-nums text-sand-900 dark:text-sand-50">{{ stat.value }}</dd>
        </div>
      {% endfor %}
    </dl>
  </section>

  <section aria-label="Filter and sort" class="mb-5">
    <h2 class="sr-only">Filters</h2>
    <div class="-mx-4 overflow-x-auto px-4 pb-1 no-scrollbar sm:mx-0 sm:overflow-visible sm:px-0">
      <div class="flex w-max gap-2 sm:w-full sm:flex-wrap">
        {% set chips = [
          { group: "all", value: "", label: "All" },
          { group: "band", value: "in-budget", label: "In budget", band: "in-budget" },
          { group: "band", value: "stretch", label: "Stretch", band: "stretch" },
          { group: "kind", value: "apartment", label: "Apartments" },
          { group: "kind", value: "townhouse", label: "Townhouses" },
          { group: "state", value: "PA", label: "PA" },
          { group: "state", value: "NJ", label: "NJ" },
          { group: "rating", value: "4", label: "★ 4+" }
        ] %}
        {% for chip in chips %}
          <button type="button"
                  class="chip {% if chip.band %}band-{{ chip.band }}{% endif %} border-sand-300 bg-white text-sand-700 hover:border-clay-400 hover:text-clay-700 aria-pressed:border-clay-600 aria-pressed:bg-clay-600 aria-pressed:text-white dark:border-sand-700 dark:bg-sand-900 dark:text-sand-300 dark:hover:text-clay-300 dark:aria-pressed:border-clay-500 dark:aria-pressed:bg-clay-600 dark:aria-pressed:text-white"
                  data-group="{{ chip.group }}"
                  data-value="{{ chip.value }}"
                  aria-pressed="{{ 'true' if chip.group == 'all' else 'false' }}">
            {% if chip.band %}<span class="band-bar h-2 w-2 shrink-0 rounded-full" aria-hidden="true"></span>{% endif %}
            {{ chip.label }}
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="text-xs font-medium uppercase tracking-wider text-sand-500 dark:text-sand-400">Sort</span>
      {% set sorts = [
        { value: "rating", label: "Rating" },
        { value: "rent", label: "Rent" },
        { value: "work", label: "Work commute" }
      ] %}
      {% for sort in sorts %}
        <button type="button"
                class="chip border-transparent bg-sand-100 text-sand-700 hover:bg-sand-200 aria-pressed:bg-sand-800 aria-pressed:text-sand-50 dark:bg-sand-800 dark:text-sand-300 dark:hover:bg-sand-700 dark:aria-pressed:bg-sand-100 dark:aria-pressed:text-sand-900"
                data-sort="{{ sort.value }}"
                aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ sort.label }}</button>
      {% endfor %}
    </div>

    <p id="result-count" class="mt-3 text-sm text-sand-500 dark:text-sand-400" role="status" aria-live="polite">
      Showing all {{ homes.counts.total }} listings
    </p>
  </section>

  <div id="grid" class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,19rem),1fr))] gap-4">
    {% for l in homes.listings %}
      <article class="listing-card band-{{ l.bandKey }} group relative flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-sand-300 hover:shadow-md dark:border-sand-800 dark:bg-sand-900 dark:hover:border-sand-700{% if l.isGone %} opacity-55 saturate-50{% endif %}"
               data-band="{{ l.bandKey }}"
               data-kind="{{ l.kind }}"
               data-state="{{ l.state }}"
               data-rating="{{ l.rating | default(0) }}"
               data-rent="{{ l.rent if l.rent else '' }}"
               data-work="{{ l.workMin if l.workMin else '' }}"
               data-gone="{{ 1 if l.isGone else 0 }}">

        <span class="band-bar absolute inset-x-0 top-0 h-1" aria-hidden="true"></span>

        {% if l.img %}
          <img src="{{ l.img }}" alt="Screenshot of the {{ l.title }} listing" loading="lazy" decoding="async"
               class="aspect-[16/9] w-full border-b border-sand-200 object-cover object-top dark:border-sand-800">
        {% endif %}

        <div class="flex flex-1 flex-col gap-3 p-4 pt-4">

          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="font-serif text-[1.0625rem] font-semibold leading-snug text-sand-900 dark:text-sand-50">
                <a href="/listing/{{ l.id }}/" class="after:absolute after:inset-0 after:content-['']">{{ l.title }}</a>
              </h3>
              <p class="mt-0.5 truncate text-xs text-sand-500 dark:text-sand-400">
                {% if l.subtitle %}{{ l.subtitle }} &middot; {% endif %}{{ l.place }}
              </p>
            </div>
            <div class="shrink-0 text-right">
              <p class="font-serif text-2xl font-semibold leading-none tabular-nums text-sand-900 dark:text-sand-50">
                {{ l.rentLabel if l.rentLabel else "TBD" }}
              </p>
              <p class="mt-1 text-[0.6875rem] font-medium text-sand-400 dark:text-sand-500">
                {% if l.rentLabel %}per month{% else %}rent unknown{% endif %}
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-1.5">
            <span class="band-pill inline-flex items-center rounded-full border px-2 py-0.5 text-[0.6875rem] font-semibold">{{ l.band.label }}</span>
            {% if l.isGone %}
              <span class="inline-flex items-center rounded-full border border-rose-300 bg-rose-50 px-2 py-0.5 text-[0.6875rem] font-semibold text-rose-700 dark:border-rose-900 dark:bg-rose-950 dark:text-rose-300">No longer listed</span>
            {% elif l.verification == "needs-call" %}
              <span class="inline-flex items-center rounded-full border border-sand-300 bg-sand-100 px-2 py-0.5 text-[0.6875rem] font-medium text-sand-600 dark:border-sand-700 dark:bg-sand-800 dark:text-sand-300">Needs a call</span>
            {% elif l.verification == "unverified" %}
              <span class="inline-flex items-center rounded-full border border-sand-300 bg-sand-100 px-2 py-0.5 text-[0.6875rem] font-medium text-sand-600 dark:border-sand-700 dark:bg-sand-800 dark:text-sand-300">Unverified</span>
            {% endif %}
            <span class="text-[0.6875rem] text-sand-400 dark:text-sand-500">{{ l.kind | capitalize }}</span>
          </div>

          <p class="text-sm text-sand-600 dark:text-sand-300">
            {% if l.specs.length %}{{ l.specs | join(" &middot; ") | safe }}{% else %}<span class="text-sand-400 dark:text-sand-500">Size not listed</span>{% endif %}
          </p>

          <dl class="mt-auto grid grid-cols-2 gap-x-3 gap-y-1 border-t border-sand-100 pt-3 text-xs dark:border-sand-800">
            <div>
              <dt class="flex items-center gap-1.5 font-medium text-sand-500 dark:text-sand-400">
                <span class="h-2 w-2 rounded-full bg-route-work" aria-hidden="true"></span> Work
              </dt>
              <dd class="mt-0.5 tabular-nums {% if l.workSlow %}font-semibold text-rose-600 dark:text-rose-400{% else %}text-sand-700 dark:text-sand-200{% endif %}">
                {{ l.workLabel if l.workLabel else "—" }}
              </dd>
            </div>
            <div>
              <dt class="flex items-center gap-1.5 font-medium text-sand-500 dark:text-sand-400">
                <span class="h-2 w-2 rounded-full bg-route-home" aria-hidden="true"></span> Home
              </dt>
              <dd class="mt-0.5 tabular-nums text-sand-700 dark:text-sand-200">{{ l.homeLabel if l.homeLabel else "—" }}</dd>
            </div>
          </dl>

          <p class="text-sm leading-none text-amber-500" aria-label="Rated {{ l.rating | default(0) }} out of 5">
            <span aria-hidden="true">{% for on in l.stars %}{% if on %}&#9733;{% else %}<span class="text-sand-300 dark:text-sand-700">&#9733;</span>{% endif %}{% endfor %}</span>
          </p>

        </div>
      </article>
    {% endfor %}
  </div>

  <p id="empty-state" class="hidden rounded-2xl border border-dashed border-sand-300 px-6 py-12 text-center text-sm text-sand-500 dark:border-sand-700 dark:text-sand-400">
    Nothing matches those filters. Try tapping <strong class="font-semibold">All</strong>.
  </p>

  <p class="mt-8 text-center">
    <a href="/map/" class="tap rounded-full border border-sand-300 bg-white px-5 text-sm font-semibold text-clay-700 hover:border-clay-400 dark:border-sand-700 dark:bg-sand-900 dark:text-clay-300">See them all on the map</a>
  </p>

</div>

<script>
(function () {
  var grid = document.getElementById("grid");
  if (!grid) return;

  var cards = Array.prototype.slice.call(grid.querySelectorAll(".listing-card"));
  var chips = Array.prototype.slice.call(document.querySelectorAll("[data-group]"));
  var sortButtons = Array.prototype.slice.call(document.querySelectorAll("[data-sort]"));
  var countEl = document.getElementById("result-count");
  var emptyEl = document.getElementById("empty-state");
  var STORE_KEY = "home-finder-view";

  var active = { band: [], kind: [], state: [], rating: [] };
  var sortBy = "rating";

  function num(el, attr) {
    var raw = el.getAttribute(attr);
    if (raw === null || raw === "") return null;
    var value = Number(raw);
    return isNaN(value) ? null : value;
  }

  function matches(card) {
    if (active.band.length && active.band.indexOf(card.getAttribute("data-band")) === -1) return false;
    if (active.kind.length && active.kind.indexOf(card.getAttribute("data-kind")) === -1) return false;
    if (active.state.length && active.state.indexOf(card.getAttribute("data-state")) === -1) return false;
    if (active.rating.length && (num(card, "data-rating") || 0) < 4) return false;
    return true;
  }

  // Nulls (unknown rent, missing commute) always sink to the bottom.
  function compareNumbers(a, b, attr) {
    var av = num(a, attr);
    var bv = num(b, attr);
    if (av === null && bv === null) return 0;
    if (av === null) return 1;
    if (bv === null) return -1;
    return av - bv;
  }

  function compare(a, b) {
    // Listings that are gone always go last, whatever the sort.
    var goneDelta = num(a, "data-gone") - num(b, "data-gone");
    if (goneDelta !== 0) return goneDelta;

    if (sortBy === "rent") return compareNumbers(a, b, "data-rent");
    if (sortBy === "work") return compareNumbers(a, b, "data-work");

    var ratingDelta = (num(b, "data-rating") || 0) - (num(a, "data-rating") || 0);
    if (ratingDelta !== 0) return ratingDelta;
    return compareNumbers(a, b, "data-rent");
  }

  function anyFilterActive() {
    return active.band.length + active.kind.length + active.state.length + active.rating.length > 0;
  }

  function render() {
    var visible = 0;
    cards.forEach(function (card) {
      var show = matches(card);
      card.classList.toggle("hidden", !show);
      if (show) visible++;
    });

    cards.slice().sort(compare).forEach(function (card) {
      grid.appendChild(card);
    });

    if (countEl) {
      countEl.textContent = anyFilterActive()
        ? "Showing " + visible + " of " + cards.length + " listings"
        : "Showing all " + cards.length + " listings";
    }
    if (emptyEl) emptyEl.classList.toggle("hidden", visible !== 0);
    grid.classList.toggle("hidden", visible === 0);

    chips.forEach(function (chip) {
      var group = chip.getAttribute("data-group");
      if (group === "all") {
        chip.setAttribute("aria-pressed", anyFilterActive() ? "false" : "true");
        return;
      }
      var on = active[group] && active[group].indexOf(chip.getAttribute("data-value")) !== -1;
      chip.setAttribute("aria-pressed", on ? "true" : "false");
    });
    sortButtons.forEach(function (button) {
      button.setAttribute("aria-pressed", button.getAttribute("data-sort") === sortBy ? "true" : "false");
    });

    try {
      sessionStorage.setItem(STORE_KEY, JSON.stringify({ active: active, sortBy: sortBy }));
    } catch (err) { /* private mode — filters just won't persist */ }
  }

  chips.forEach(function (chip) {
    chip.addEventListener("click", function () {
      var group = chip.getAttribute("data-group");
      if (group === "all") {
        active = { band: [], kind: [], state: [], rating: [] };
      } else {
        var value = chip.getAttribute("data-value");
        var list = active[group];
        var at = list.indexOf(value);
        if (at === -1) list.push(value); else list.splice(at, 1);
      }
      render();
    });
  });

  sortButtons.forEach(function (button) {
    button.addEventListener("click", function () {
      sortBy = button.getAttribute("data-sort");
      render();
    });
  });

  // Come back from a listing page and the view is how you left it.
  try {
    var saved = JSON.parse(sessionStorage.getItem(STORE_KEY) || "null");
    if (saved && saved.active) {
      ["band", "kind", "state", "rating"].forEach(function (group) {
        if (Array.isArray(saved.active[group])) active[group] = saved.active[group];
      });
      if (saved.sortBy) sortBy = saved.sortBy;
    }
  } catch (err) { /* ignore */ }

  render();
})();
</script>
